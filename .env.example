# Required
ANTHROPIC_API_KEY=

# Optional - model and behaviour
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low

# Lead capture - leads are always written to the server logs; set these to also deliver them
RESEND_API_KEY=
LEAD_FROM_EMAIL=Permaloc Chatbot <chatbot@yourdomain.com>
LEAD_TO_EMAIL=sales@permaloc.com
LEAD_WEBHOOK_URL=

# Restrict which sites may embed the chat (space-separated), e.g. "https://www.permaloc.com https://permaloc.com"
ALLOWED_FRAME_ANCESTORS=*

# Reporting dashboard (see dashboard/README.md). Leave DATABASE_URL empty to record nothing.
DATABASE_URL=
# Store chat transcripts for the dashboard's session view ("off" keeps only stats and the AI summary)
ANALYTICS_STORE_TRANSCRIPTS=on
# AI labeling of each session's conclusion, topics and summary ("off" uses simple rules only)
ANALYTICS_CLASSIFY=on
ANALYTICS_MODEL=claude-opus-5-5
