# Same database the chatbot writes to (a read-only database user is recommended)
DATABASE_URL=

# Password for the dashboard login page (use a long one)
DASHBOARD_PASSWORD=

# Random string used to sign login cookies, e.g. `openssl rand -hex 32`.
# Changing it (or the password) signs everyone out.
DASHBOARD_SESSION_SECRET=

# Optional: hours a login lasts (default 12) and the time zone used for days, months and YTD
DASHBOARD_SESSION_HOURS=12
DASHBOARD_TZ=America/Detroit
